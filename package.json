{
  "name": "attendra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@attendra/api... --filter=@attendra/worker...",
    "build": "turbo run build",
    "lint": "turbo run build --filter='./packages/*' --output-logs=errors-only && eslint . --max-warnings=0",
    "lint:fix": "turbo run build --filter='./packages/*' --output-logs=errors-only && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "pnpm test:unit && pnpm test:int && pnpm test:e2e",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "turbo run build --filter=@attendra/api^... && vitest run --project e2e",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "pnpm --filter @attendra/server db:migrate",
    "db:generate": "pnpm --filter @attendra/server db:generate",
    "db:seed": "pnpm --filter @attendra/server db:seed",
    "db:reset": "pnpm --filter @attendra/server db:reset",
    "api:scenarios": "pnpm --filter @attendra/api scenarios"
  },
  "devDependencies": {
    "@attendra/config": "workspace:*",
    "@swc/core": "1.16.18",
    "@types/node": "^22.19.0",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3"
  }
}
