{
  "name": "@attendra/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json && concurrently -k -n tsc,api -c blue,green \"tsc -b tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --enable-source-maps --watch-path=dist --watch-path=../../packages/server/dist dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "scenarios": "node --env-file-if-exists=../../.env --import tsx scenarios/run.ts",
    "openapi:export": "node --import tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@attendra/contracts": "workspace:*",
    "@attendra/server": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@attendra/config": "workspace:*",
    "@nestjs/testing": "12.1.2",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.11.1",
    "otplib": "13.5.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
