{
  "name": "@attendra/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas, enums and API contracts shared by backend and clients",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@attendra/config": "workspace:*",
    "tsdown": "0.23.1"
  }
}
