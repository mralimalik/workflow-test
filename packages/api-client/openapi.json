{
  "openapi": "3.1.0",
  "info": {
    "title": "Attendra API",
    "version": "0.0.0",
    "description": "Attendra API v1"
  },
  "servers": [
    {
      "url": "http://localhost:4000"
    }
  ],
  "paths": {
    "/internal/health/live": {
      "get": {
        "operationId": "health.live",
        "summary": "Liveness: the process is up",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResult"
                }
              }
            }
          },
          "500": {
            "description": "`internal_error` — Something went wrong",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/internal/health/ready": {
      "get": {
        "operationId": "health.ready",
        "summary": "Readiness: dependencies (Postgres, Redis) are reachable",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Ready to serve traffic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResult"
                }
              }
            }
          },
          "500": {
            "description": "`internal_error` — Something went wrong",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is down",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/public/files/uploads/{token}": {
      "put": {
        "operationId": "files.upload",
        "summary": "Upload file bytes to a signed upload URL",
        "tags": ["Files"],
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "schema": {
              "$ref": "#/components/schemas/__schema0"
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/webp": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadResult"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden` — You are not allowed to do this",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`not_found` — The resource was not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`conflict` — The request conflicts with the current state",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "`payload_too_large` — The request body is too large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "`unsupported_media_type` — Unsupported content type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed` — The request is invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "`internal_error` — Something went wrong",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/public/files/{token}": {
      "get": {
        "operationId": "files.download",
        "summary": "Download a file from a signed download URL",
        "tags": ["Files"],
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "schema": {
              "$ref": "#/components/schemas/__schema0"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "File bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden` — You are not allowed to do this",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`not_found` — The resource was not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed` — The request is invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "`internal_error` — Something went wrong",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "__schema0": {
        "type": "string",
        "minLength": 20,
        "maxLength": 600
      },
      "HealthResult": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/__schema1"
          },
          "info": {
            "$ref": "#/components/schemas/__schema2"
          },
          "error": {
            "$ref": "#/components/schemas/__schema4"
          },
          "details": {
            "$ref": "#/components/schemas/__schema5"
          }
        },
        "required": ["status", "details"],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/__schema6"
          },
          "title": {
            "$ref": "#/components/schemas/__schema7"
          },
          "status": {
            "$ref": "#/components/schemas/__schema8"
          },
          "code": {
            "$ref": "#/components/schemas/__schema9"
          },
          "detail": {
            "$ref": "#/components/schemas/__schema10"
          },
          "requestId": {
            "$ref": "#/components/schemas/__schema11"
          },
          "errors": {
            "$ref": "#/components/schemas/__schema12"
          }
        },
        "required": ["type", "title", "status", "code", "detail", "requestId"],
        "additionalProperties": false,
        "description": "RFC 9457 problem details"
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "#/components/schemas/__schema13"
          },
          "code": {
            "$ref": "#/components/schemas/__schema14"
          },
          "message": {
            "$ref": "#/components/schemas/__schema15"
          }
        },
        "required": ["path", "code", "message"],
        "additionalProperties": false
      },
      "FileUploadResult": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/__schema16"
          },
          "status": {
            "$ref": "#/components/schemas/__schema17"
          },
          "contentType": {
            "$ref": "#/components/schemas/__schema18"
          },
          "sizeBytes": {
            "$ref": "#/components/schemas/__schema19"
          }
        },
        "required": ["id", "status", "contentType", "sizeBytes"],
        "additionalProperties": false
      },
      "__schema1": {
        "type": "string",
        "enum": ["ok", "error", "shutting_down", "degraded"]
      },
      "__schema2": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "$ref": "#/components/schemas/__schema3"
        }
      },
      "__schema3": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["up", "down", "degraded"]
          }
        },
        "required": ["status"],
        "additionalProperties": {}
      },
      "__schema4": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "$ref": "#/components/schemas/__schema3"
        }
      },
      "__schema5": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "$ref": "#/components/schemas/__schema3"
        }
      },
      "__schema6": {
        "type": "string",
        "format": "uri"
      },
      "__schema7": {
        "type": "string"
      },
      "__schema8": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "__schema9": {
        "type": "string",
        "description": "Stable machine-readable error code"
      },
      "__schema10": {
        "type": ["string", "null"]
      },
      "__schema11": {
        "type": ["string", "null"]
      },
      "__schema12": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/FieldError"
        }
      },
      "__schema13": {
        "type": "string",
        "description": "Dot path to the field, e.g. `address.city`",
        "example": "email"
      },
      "__schema14": {
        "type": "string",
        "example": "invalid_format"
      },
      "__schema15": {
        "type": "string"
      },
      "__schema16": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "__schema17": {
        "type": "string",
        "enum": ["ready"]
      },
      "__schema18": {
        "type": "string"
      },
      "__schema19": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    }
  }
}
