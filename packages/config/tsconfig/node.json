{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Attendra Node (NestJS backend, CommonJS output; node20 = require(esm) for ESM-only deps like NestJS 12)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "Node20",
    "moduleResolution": "Node16",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false
  }
}
