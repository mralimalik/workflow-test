{
  "name": "@attendra/server",
  "version": "0.0.0",
  "private": true,
  "description": "Backend modules, kernel and composition roots shared by the api, worker and media apps (BACKEND.md \u00a72)",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx scripts/db-migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx scripts/db-seed.ts",
    "db:reset": "node --env-file-if-exists=../../.env --import tsx scripts/db-reset.ts",
    "db:check-rls": "node --env-file-if-exists=../../.env --import tsx scripts/db-check-rls.ts",
    "admin:create": "tsc -b tsconfig.build.json && node --env-file-if-exists=../../.env --import tsx scripts/admin-create.ts"
  },
  "dependencies": {
    "@attendra/contracts": "workspace:*",
    "@attendra/utils": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.1.2",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@socket.io/redis-streams-adapter": "0.3.1",
    "@standard-schema/spec": "1.1.0",
    "bowser": "2.14.1",
    "bullmq": "6.3.12",
    "compression": "1.8.2",
    "cookie": "1.1.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "intl-messageformat": "12.1.3",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.1.0",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "temporal-polyfill": "1.0.5",
    "uuid": "14.0.3",
    "zod": "4.6.6",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@attendra/config": "workspace:*",
    "@nestjs/testing": "12.1.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "ioredis": "5.11.1",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15"
  }
}
