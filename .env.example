# ---------------------------------------------------------------------------
# Attendra — local development environment.
# Copy to .env. Values here are LOCAL-ONLY defaults; never commit real secrets.
# Every variable is validated at startup (BACKEND.md §12).
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=local                         # local | dev | staging | production
LOG_LEVEL=debug                       # trace | debug | info | warn | error

# --- Docker compose (docker-compose.yml) -----------------------------------
POSTGRES_USER=attendra
POSTGRES_PASSWORD=attendra
POSTGRES_DB=attendra
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Database ---------------------------------------------------------------
# Owner role: runs migrations, bypasses RLS.
DATABASE_MIGRATION_URL=postgres://attendra:attendra@localhost:5432/attendra
# App role: used by api/worker at runtime, row-level security enforced.
DATABASE_URL=postgres://attendra_app:attendra_app@localhost:5432/attendra
DATABASE_POOL_MAX=20

# --- Redis ------------------------------------------------------------------
# Locally one instance serves both. In production these are separate instances.
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_QUEUE_URL=redis://localhost:6379/1

# --- Process ---------------------------------------------------------------
API_PORT=4000
# Express "trust proxy": hops/addresses in front of the api (load balancer). loopback locally.
TRUST_PROXY=loopback
# OpenTelemetry: traces are created (ids in logs) but not exported locally.
# Set OTEL_TRACES_EXPORTER=otlp and OTEL_EXPORTER_OTLP_ENDPOINT to export.
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# --- Public URLs ------------------------------------------------------------
API_PUBLIC_URL=http://localhost:4000
MEDIA_PUBLIC_URL=ws://localhost:4100
DASHBOARD_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CUSTOMER_APP_URL=http://localhost:3000
WIDGET_CDN_URL=http://localhost:5175

# --- Auth & security --------------------------------------------------------
# 32-byte base64 keys. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=local-dev-session-secret-change-me
JWT_SIGNING_KEY=local-dev-jwt-signing-key-change-me
# Master key for envelope encryption of provider credentials (BACKEND.md §12).
ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=   # 32 zero bytes: local only, refused in production
ENCRYPTION_MASTER_KEY_ID=local-1
COOKIE_DOMAIN=localhost

# --- Files ------------------------------------------------------------------
# Object storage: local disk for now (S3 / Azure Blob later).
FILES_STORAGE=local
FILES_LOCAL_DIR=.data/files

# --- Email (Mailpit locally) ------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Attendra <no-reply@attendra.local>"

# --- Providers (leave blank locally until needed) --------------------------
# Platform-level provider credentials are stored encrypted in the database and
# managed from the admin console. These env values only seed local development.
SEED_OPENAI_API_KEY=
SEED_AZURE_OPENAI_ENDPOINT=
SEED_AZURE_OPENAI_API_KEY=
SEED_TWILIO_ACCOUNT_SID=
SEED_TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
